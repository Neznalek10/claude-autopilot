# Environment template for Claude Autopilot. `autopilot init` copies it to .env (mode 600).
# Copy it by hand only if you skip init. Empty values count as unset, so the defaults apply.
# A real environment variable always wins over a value in .env.
# Never commit .env: it holds the Telegram bot token.

# Project home folder. Read only from the real environment, not from .env.
# Default: the folder that contains the autopilot package.
# AUTOPILOT_HOME=

# Path to the task file. Default: tasks.toml in the project home.
AUTOPILOT_TASKS_FILE=

# Folder for the SQLite database (autopilot.db) and the log file (autopilot.log).
# Default: data/ in the project home.
AUTOPILOT_DATA_DIR=

# IANA time zone for schedules, for example Europe/Prague. Default: the system time zone.
AUTOPILOT_TIMEZONE=

# How many runs may execute at the same time, from 1 to 4. Default: 1.
AUTOPILOT_MAX_PARALLEL=

# Log level: DEBUG, INFO, WARNING or ERROR. Default: INFO.
AUTOPILOT_LOG_LEVEL=

# Path to the Claude Code CLI binary. Default: found on PATH or in the usual install folders.
CLAUDE_BIN=

# Telegram bot token from @BotFather. `autopilot telegram-setup` writes it for you.
TELEGRAM_BOT_TOKEN=

# Telegram chat id that may talk to the bot. An integer, may be negative.
# `autopilot telegram-setup` writes it for you.
TELEGRAM_CHAT_ID=
