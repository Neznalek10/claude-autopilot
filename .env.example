# Environment template for Claude Autopilot. `autopilot init` copies it to .env (mode 600).
# Copy it by hand only if you skip init. Empty values count as unset, so the defaults apply.
# A real environment variable always wins over a value in .env.
# Never commit .env: it holds the Telegram bot token.

# Project home folder. Read only from the real environment, not from .env.
# Default: the folder that contains the autopilot package.
# AUTOPILOT_HOME=

# Path to the task file. Default: tasks.toml in the project home.
AUTOPILOT_TASKS_FILE=

# Folder for the SQLite database (autopilot.db) and the log file (autopilot.log).
# Default: data/ in the project home.
AUTOPILOT_DATA_DIR=

# IANA time zone for schedules, for example Europe/Berlin. Default: the system time zone.
AUTOPILOT_TIMEZONE=

# Markdown balance file that the /spend command in Telegram writes to. It needs a line
# 'Current balance: **<number> <CUR>**' and uses one '## <Month> <Year>' table per month.
# Leave empty to turn money logging off. Relative paths start at the project home.
AUTOPILOT_BALANCE_FILE=

# Web viewer: a read-only page with your Autopilot chats and task runs, made for phones.
# It is off unless you set a token of at least 20 characters. Create one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
AUTOPILOT_WEB_TOKEN=
# Address and port. The default 127.0.0.1 only allows this computer. To use it from your phone,
# put the computer and the phone on a private network such as Tailscale and set the computer's
# private address here. Never expose it to the open internet.
AUTOPILOT_WEB_HOST=
AUTOPILOT_WEB_PORT=
# Folder with Claude Code transcripts (usually ~/.claude/projects) to browse in the viewer.
# Leave empty to hide the VS Code tab.
AUTOPILOT_CLAUDE_PROJECTS_DIR=

# How many runs may execute at the same time, from 1 to 4. Default: 1.
AUTOPILOT_MAX_PARALLEL=

# Log level: DEBUG, INFO, WARNING or ERROR. Default: INFO.
AUTOPILOT_LOG_LEVEL=

# Path to the Claude Code CLI binary. Default: found on PATH or in the usual install folders.
CLAUDE_BIN=

# Telegram bot token from @BotFather. `autopilot telegram-setup` writes it for you.
TELEGRAM_BOT_TOKEN=

# Your own Telegram user id (a positive number): the only chat the bot answers.
# Group chats are not supported. `autopilot telegram-setup` writes it for you.
TELEGRAM_CHAT_ID=
